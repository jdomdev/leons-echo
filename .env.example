# ─── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=leons_echo
POSTGRES_PASSWORD=change_me
POSTGRES_DB=leons_echo_db

# SQLAlchemy async DSN (used by the api service)
DATABASE_URL=postgresql+asyncpg://leons_echo:change_me@db:5432/leons_echo_db

# ─── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development

# ─── JWT (RS256) ───────────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048
JWT_SECRET_KEY=change_me

# ─── Spotify OAuth2 ────────────────────────────────────────────────────────────
# Register your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=change_me
SPOTIFY_CLIENT_SECRET=change_me
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/callback

# ─── Fernet encryption (refresh_token at rest) ─────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change_me
